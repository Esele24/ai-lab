# Copy this file to .env and paste the key.
# The working key is in CLAUDE/tender-tool/.env.local
GEMINI_API_KEY=

# gemini-2.5-flash is the verified model for this key.
# A 429 whose body says "limit: 0" means the model is wrong, not that you are rate limited.
GEMINI_MODEL=gemini-2.5-flash

# Embeddings. gemini-embedding-001 is current; text-embedding-004 is the older name.
EMBED_MODEL=gemini-embedding-001
